---
import { SITE_TITLE } from '@/consts';
---

<header class="sticky top-0 z-40 border-b border-border bg-background py-5">
  <div class="container-page flex items-center gap-4 md:gap-8 md:px-14">
    <a
      href="/"
      aria-current={Astro.url.pathname === '/' ? 'page' : undefined}
      class="mr-auto font-display text-lg font-bold transition-colors hover:text-cyan"
    >
      {SITE_TITLE}
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      <a href="/#projects" class="text-sm font-medium text-foreground transition-colors hover:text-cyan">Projects</a>
      <a href="/#skills" class="text-sm font-medium text-foreground transition-colors hover:text-cyan">Skills</a>
      <a href="/#experience" class="text-sm font-medium text-foreground transition-colors hover:text-cyan">Experience</a>
      <a href="/#contact" class="text-sm font-medium text-foreground transition-colors hover:text-cyan">Contact</a>
    </nav>

    <span
      class="mono hidden items-center gap-2 rounded-lg border border-border px-3 py-1.5 font-mono text-xs font-medium text-cyan md:flex"
    >
      <span class="inline-block size-2 rounded-full bg-success"></span>
      AVAILABLE
    </span>

    <details id="mobile-nav" class="relative md:hidden">
      <summary
        class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-lg border border-border [&::-webkit-details-marker]:hidden"
      >
        <span class="sr-only">Open menu</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
      </summary>
      <nav
        class="absolute top-full right-0 z-20 mt-2 flex w-48 flex-col gap-1 rounded-lg border border-border bg-background p-2 shadow-lg"
      >
        <a href="/#projects" class="rounded-md px-3 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted hover:text-cyan"
          >Projects</a
        >
        <a href="/#skills" class="rounded-md px-3 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted hover:text-cyan"
          >Skills</a
        >
        <a href="/#experience" class="rounded-md px-3 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted hover:text-cyan"
          >Experience</a
        >
        <a href="/#contact" class="rounded-md px-3 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted hover:text-cyan"
          >Contact</a
        >
        <span
          class="mono mt-1 flex items-center gap-2 rounded-lg border border-border px-3 py-1.5 font-mono text-xs font-medium text-cyan"
        >
          <span class="inline-block size-2 rounded-full bg-success"></span>
          AVAILABLE
        </span>
      </nav>
    </details>
  </div>
</header>

<script>
  const details = document.getElementById('mobile-nav');

  if (details) {
    const close = (refocus = false) => {
      details.removeAttribute('open');
      if (refocus) details.querySelector('summary')?.focus();
    };

    details.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => close()));

    // A menu should be dismissible without picking one of its items.
    document.addEventListener('click', (event) => {
      if (!details.hasAttribute('open')) return;
      if (!details.contains(event.target as Node)) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && details.hasAttribute('open')) close(true);
    });
  }
</script>
