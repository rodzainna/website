---
import { SOCIALS } from '@/consts';
import Button from '@/components/Button.astro';
---

<section id="contact" class="py-10 md:py-16">
  <div class="container-page md:px-14">
    <div
      class="rounded-lg border border-surface-on-dark bg-surface-on-dark p-8 md:p-12 dark:border-cyan"
    >
      <h2 class="mb-2 font-display text-3xl font-bold text-foreground-on-dark">
        Let's work together
      </h2>
      <p class="mb-7 max-w-[52ch] text-base text-muted-foreground-on-dark">
        Open to full-time senior frontend and full-stack roles. Fully remote, no on-site. Reach
        out any time.
      </p>
      <div class="flex flex-wrap gap-3">
        <Button href={`mailto:${SOCIALS.email}`}>Email me</Button>
        <Button
          variant="secondary-on-dark"
          href={SOCIALS.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </Button>
      </div>
    </div>
  </div>
</section>
