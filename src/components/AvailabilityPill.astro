---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/lib/utils';

type Props = HTMLAttributes<'span'>;

const { class: className, ...rest } = Astro.props;
---

{/* `inline-flex` is a default, not a fixture: callers pass their own display
    (`hidden md:flex`, `mt-1 flex`) and twMerge drops this one. Without it a
    caller that passes no display gets an inert `items-center` and a
    misaligned status dot. */}
<span
  class={cn(
    'inline-flex items-center rounded-lg border border-cyan px-3 py-1.5 font-mono text-xs font-medium text-cyan',
    className
  )}
  {...rest}
>
  AVAILABLE
</span>
