---
import { SITE_TITLE } from '@/consts';

const year = new Date().getFullYear();
---

<footer class="container-page flex flex-col items-center gap-2 py-7 text-center md:px-14">
  <a
    href="/privacy"
    class="font-mono text-xs text-muted-foreground uppercase transition-colors hover:text-cyan"
  >
    Privacy policy
  </a>
  <p class="font-mono text-xs text-muted-foreground uppercase">© {year} {SITE_TITLE}</p>
</footer>
