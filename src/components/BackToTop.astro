---
---

<div class="group fixed right-4 bottom-6 z-30 sm:right-6">
  <span
    class="pointer-events-none absolute top-1/2 right-full mr-2 -translate-y-1/2 rounded-md bg-foreground px-2 py-1 font-mono text-xs font-medium whitespace-nowrap text-background opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
  >
    Back to top
  </span>
  <button
    id="back-to-top"
    type="button"
    aria-label="Back to top"
    class="flex h-10 w-10 translate-y-4 items-center justify-center rounded-full border border-border bg-background text-foreground opacity-0 shadow-lg pointer-events-none transition-[opacity,transform] duration-200 hover:border-foreground data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
  >
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <line x1="12" y1="19" x2="12" y2="5"></line>
    <polyline points="5 12 12 5 19 12"></polyline>
  </svg>
  </button>
</div>

<script>
  const button = document.getElementById('back-to-top');

  if (button) {
    const toggleVisibility = () => {
      button.dataset.visible = window.scrollY > 400 ? 'true' : 'false';
    };

    toggleVisibility();
    window.addEventListener('scroll', toggleVisibility, { passive: true });

    button.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
