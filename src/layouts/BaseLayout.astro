---
import '@/styles/global.css';
import {
  SITE_TITLE,
  SITE_TAGLINE,
  SITE_DEFAULT_TITLE,
  SITE_DESCRIPTION,
  SITE_OG_IMAGE,
  SITE_THEME_COLOR,
  SITE_NOINDEX,
  FONT_SCALE_MIN,
  FONT_SCALE_MAX,
} from '@/consts';
import { buildPersonSchema, toJsonLd } from '@/lib/schema';

type Props = {
  title?: string;
  description?: string;
};

const { title = SITE_DEFAULT_TITLE, description = SITE_DESCRIPTION } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(SITE_OG_IMAGE, Astro.site);

const personSchema = buildPersonSchema({ url: Astro.site?.href, image: ogImage.href });
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="author" content={SITE_TITLE} />

		{/* Blocked while in progress — see SITE_NOINDEX in consts.ts and public/robots.txt. */}
		<meta name="robots" content={SITE_NOINDEX ? 'noindex, nofollow' : 'index, follow'} />

		{/* Open Graph — drives the LinkedIn / Slack / iMessage link preview. */}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${SITE_TITLE} — ${SITE_TAGLINE}`} />
		<meta property="og:locale" content="en_US" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={`${SITE_TITLE} — ${SITE_TAGLINE}`} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 256x256" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content={SITE_THEME_COLOR} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<script
			type="application/ld+json"
			set:html={toJsonLd(personSchema)}
			is:inline
		/>

		<script is:inline define:vars={{ FONT_SCALE_MIN, FONT_SCALE_MAX }}>
			(function () {
				var root = document.documentElement;

				var storedTheme = localStorage.getItem('theme');
				var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				root.classList.toggle('dark', storedTheme ? storedTheme === 'dark' : prefersDark);

				var scale = parseFloat(localStorage.getItem('a11y-font-scale') || '1');
				if (!isFinite(scale)) scale = 1;
				root.style.zoom = Math.min(FONT_SCALE_MAX, Math.max(FONT_SCALE_MIN, scale));

				var reduceMotion = localStorage.getItem('a11y-reduce-motion') === 'true';
				root.classList.toggle('reduce-motion', reduceMotion);
			})();
		</script>
	</head>
	<body class="min-h-screen bg-background text-foreground">
		<a
			href="#main"
			class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-50 focus-visible:rounded-lg focus-visible:bg-primary focus-visible:px-4 focus-visible:py-2 focus-visible:text-sm focus-visible:font-medium focus-visible:text-primary-foreground"
		>
			Skip to content
		</a>
		<slot />
	</body>
</html>
